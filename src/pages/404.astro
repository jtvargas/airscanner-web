---
import SiteLayout from '../layouts/SiteLayout.astro';

const base = import.meta.env.BASE_URL;
---

<SiteLayout
  title="Page not found — AirScanner"
  description="This page could not be found. Return to AirScanner to learn about Wi-Fi scanning on iPhone and iPad."
  noindex
>
  <section class="not-found wrap" aria-labelledby="not-found-title">
    <p class="eyebrow">404 / Page not found</p>
    <h1 id="not-found-title">Nothing on this page.</h1>
    <p>The link may have changed, or the address may be incorrect.</p>
    <a class="text-link" href={base}>Back to AirScanner <span aria-hidden="true">↗</span></a>
  </section>
</SiteLayout>
