---
import SiteLayout from '../layouts/SiteLayout.astro';

const base = import.meta.env.BASE_URL;
const application = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'AirScanner',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'iOS 17 or later; iPadOS 17 or later',
  description: 'Scan from a compatible eSCL/AirScan flatbed scanner over local Wi-Fi to PDFs on iPhone and iPad, with on-device text recognition.',
  url: new URL(base, Astro.site).href,
  image: new URL(`${base}images/app-icon.png`, Astro.site).href,
};
---

<SiteLayout
  title="AirScanner — Wi-Fi scanner to PDF on iPhone & iPad"
  description="Turn scans from your eSCL/AirScan-compatible Wi-Fi flatbed scanner into PDFs on iPhone and iPad. Local saving, on-device OCR, and straightforward sharing."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(application)} />

  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow">Your scanner, without the computer</p>
      <h1 id="hero-title">From Wi-Fi scanner<br class="desktop-break" /> to PDF.<br /><span>On iPhone and iPad.</span></h1>
      <p class="hero-description">Put your document on the glass. AirScanner connects to your compatible flatbed scanner, saves the PDF on your device, and lets you share it when you’re ready.</p>
      <a class="text-link" href="#how-it-works">See how it works <span aria-hidden="true">↗</span></a>
      <p class="hero-requirement">iOS / iPadOS 17+ · eSCL / AirScan scanner required</p>
      <p class="privacy-note">No account. No ads. No in-app tracking.</p>
    </div>
    <figure class="hero-visual">
      <div class="screenshot-mat">
        <img
          class="app-screenshot"
          src={`${base}images/scanners.webp`}
          width="660"
          height="1320"
          alt="AirScanner’s Scanners screen, with local scanner discovery and glass-check controls."
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <figcaption>Your scanner, found on your local network.</figcaption>
    </figure>
  </section>

  <section class="workflow wrap ruled-section" id="how-it-works" aria-labelledby="workflow-title">
    <div class="section-heading">
      <p class="eyebrow">From glass to file</p>
      <h2 id="workflow-title">Three steps. No camera.</h2>
      <p>This is for the scanner you already have—not a photo of your document.</p>
    </div>
    <ol class="steps">
      <li>
        <span class="step-number" aria-hidden="true">01</span>
        <div><h3>Find your scanner.</h3><p>Join the same Wi-Fi network and allow Local Network access. AirScanner discovers compatible eSCL/AirScan scanners.</p></div>
      </li>
      <li>
        <span class="step-number" aria-hidden="true">02</span>
        <div><h3>Check the glass.</h3><p>Place your page on the flatbed. A quick preview can check for a document before you scan. It’s a helpful check, not a guarantee.</p></div>
      </li>
      <li>
        <span class="step-number" aria-hidden="true">03</span>
        <div><h3>Scan. Save. Share.</h3><p>Choose the settings your scanner supports and keep the app open. Save your PDF locally, preview it, or send it to another app.</p></div>
      </li>
    </ol>
  </section>

  <section class="scan-section wrap ruled-section" aria-labelledby="scan-title">
    <figure class="settings-visual">
      <div class="settings-mat">
        <img
          class="app-screenshot"
          src={`${base}images/scan-settings.webp`}
          width="660"
          height="1320"
          alt="AirScanner scan settings, showing the resolution and color options available from a scanner."
          loading="lazy"
          decoding="async"
        />
      </div>
      <figcaption>Resolution, color, and PDF output.</figcaption>
    </figure>
    <div class="scan-copy">
      <p class="eyebrow">PDF &amp; on-device OCR</p>
      <h2 id="scan-title">Save PDFs.<br />Find and copy text.</h2>
      <p>Search your documents in the app with on-device text recognition. Use Live Text to select and copy what you need.</p>
      <p>Share a PDF with another app, save it to Files, or export its first page to Photos. Sharing destinations and device backups follow your own system settings.</p>
      <p class="plain-note">A useful distinction: OCR helps you find and copy text in AirScanner. It does not add a searchable text layer to exported PDFs. Always check recognized text.</p>
      <a class="text-link" href={`${base}privacy/`}>Read the privacy details <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <section class="compatibility wrap ruled-section" id="compatibility" aria-labelledby="compatibility-title">
    <div class="section-heading">
      <p class="eyebrow">Before you scan</p>
      <h2 id="compatibility-title">The right scanner.<br />The same Wi-Fi.</h2>
      <p>You’ll need an iPhone or iPad running iOS or iPadOS 17+, and a flatbed scanner with eSCL / AirScan support. AirPrint alone is not enough.</p>
    </div>
    <div class="disclosures">
      <details>
        <summary>Will my scanner work?</summary>
        <div class="detail-content"><p>Check your scanner’s documentation for eSCL or AirScan flatbed scanning support. Available resolution and color options depend on the scanner. AirScanner scans the full glass; it does not automatically crop the page.</p></div>
      </details>
      <details>
        <summary>What if my scanner doesn’t appear?</summary>
        <div class="detail-content"><p>Make sure your scanner is awake, your iPhone or iPad is on the same local network, and Local Network permission is enabled for AirScanner in Settings. An isolated guest Wi-Fi network can prevent devices from finding each other.</p><p>Use a trusted network. Local scanner connections may be unencrypted.</p></div>
      </details>
      <details>
        <summary>Where do my documents go?</summary>
        <div class="detail-content"><p>PDFs, document information, and recognized text stay in the app’s storage on your device. There is no account, developer backend, or app-managed cloud sync. Normal iOS backups may include app data.</p><p>When you export or share, the destination app may upload or sync the file under its own settings and policies. <a href={`${base}privacy/`}>See the full privacy policy.</a></p></div>
      </details>
      <details>
        <summary>Need help or found a problem?</summary>
        <div class="detail-content"><p><a href="https://github.com/jtvargas/airscanner-web/issues">Open an issue in the public support repository.</a> Describe the general problem and your scanner model.</p><p>Issues are public. Never attach scans, personal details, IP addresses, serial numbers, or other network identifiers.</p></div>
      </details>
    </div>
  </section>
</SiteLayout>
