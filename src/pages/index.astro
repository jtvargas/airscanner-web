---
import SiteLayout from '../layouts/SiteLayout.astro';

const base = import.meta.env.BASE_URL;
const application = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'AirScanner',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'iOS 17 or later; iPadOS 17 or later',
  description: 'Scan documents to PDF from a compatible Wi-Fi scanner. Save files on your iPhone or iPad, search and copy text, and share scans.',
  url: new URL(base, Astro.site).href,
  image: new URL(`${base}images/app-icon.png`, Astro.site).href,
};
---

<SiteLayout
  title="AirScanner — Wi-Fi scanning for iPhone and iPad"
  description="Scan documents to PDF from a compatible Wi-Fi scanner. Save files on your iPhone or iPad, search and copy text, and share scans."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(application)} />

  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="hero-copy">
      <h1 id="hero-title">Scan to your iPhone or iPad.</h1>
      <p class="hero-description">Use your Wi-Fi scanner to save documents as PDFs. Search and copy text in the app, or share a file.</p>
      <p class="scanner-note">You need a flatbed scanner. AirScanner does not use your camera.</p>
      <a class="primary-link" href="#how-it-works">How to scan</a>
      <p class="hero-requirement">For iOS 17 or later. No account needed.</p>
    </div>
    <figure class="hero-visual">
      <div class="settings-crop">
        <img
          src={`${base}images/scan-settings.webp`}
          width="660"
          height="1320"
          alt="AirScanner showing a ready scanner, 300 dpi resolution, grayscale, and PDF output."
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <figcaption>Scan settings. <a href={`${base}images/scan-settings.webp`} aria-label="View the full scan settings screenshot">Full screenshot</a></figcaption>
    </figure>
  </section>

  <section class="guide wrap" id="how-it-works" aria-labelledby="guide-title">
    <div class="guide-intro">
      <h2 id="guide-title">How to scan</h2>
      <p>Put your phone and scanner on the same Wi-Fi network.</p>
      <figure class="scanner-figure">
        <div class="scanner-crop">
          <img
            src={`${base}images/scanners.webp`}
            width="660"
            height="1320"
            alt="AirScanner's scanner list showing a printer found on the local network."
            loading="lazy"
            decoding="async"
          />
        </div>
        <figcaption>Scanner list. <a href={`${base}images/scanners.webp`} aria-label="View the full scanner list screenshot">Full screenshot</a></figcaption>
      </figure>
    </div>
    <ol class="steps">
      <li>
        <h3>Choose your scanner</h3>
        <p>Open AirScanner, allow Local Network access, and choose your scanner and settings.</p>
      </li>
      <li>
        <h3>Check your page</h3>
        <p>Put the page on the glass, close the lid, and tap <strong>Check glass</strong>. Check the preview before scanning.</p>
      </li>
      <li>
        <h3>Save the scan</h3>
        <p>Tap <strong>Scan document</strong>. Keep the app open until your PDF is saved.</p>
      </li>
    </ol>
  </section>

  <section class="documents wrap" aria-labelledby="documents-title">
    <div>
      <h2 id="documents-title">Your saved documents</h2>
      <ul class="document-tools">
        <li>Open, rename, and search your PDFs.</li>
        <li>Select and copy text from a page.</li>
        <li>Share a PDF, save it to Files, or save its first page to Photos.</li>
      </ul>
      <p class="note">Text search works in the app. AirScanner does not add searchable text to exported PDFs.</p>
    </div>
    <div class="privacy-copy">
      <h2>No ads or tracking</h2>
      <p>The app saves PDFs and recognized text on your device. It does not send them to the developer.</p>
      <p>Device backups and apps you share with may keep their own copies.</p>
      <a class="text-link" href={`${base}privacy/`}>Privacy policy</a>
    </div>
  </section>

  <section class="support wrap" id="compatibility" aria-labelledby="support-title">
    <div class="support-heading">
      <h2 id="support-title">Scanner support</h2>
      <p>Works with eSCL / AirScan flatbed scanners on the same Wi-Fi network.</p>
    </div>
    <div class="disclosures">
      <details>
        <summary>Will my scanner work?</summary>
        <div class="detail-content">
          <p>Look for eSCL or AirScan support in your scanner's manual. AirPrint alone is not enough: a printer may support printing over Wi-Fi but not scanning.</p>
          <p>Scan settings depend on your scanner. AirScanner scans the whole glass and does not crop the page for you.</p>
        </div>
      </details>
      <details>
        <summary>Why isn't my scanner listed?</summary>
        <div class="detail-content">
          <p>Turn the scanner on. Check that your phone and scanner use the same Wi-Fi, and allow Local Network access for AirScanner in Settings.</p>
          <p>Guest Wi-Fi can block the connection. Use a network you trust: some scanners send scans without encryption.</p>
        </div>
      </details>
      <details>
        <summary>What if the glass check doesn't work?</summary>
        <div class="detail-content">
          <p>Some scanners cannot make the small preview used for this check. AirScanner then offers <strong>Scan without check</strong>.</p>
          <p>A faint page can look empty. Check its position and use <strong>Scan anyway</strong> if needed.</p>
        </div>
      </details>
      <details>
        <summary>How do I report a problem?</summary>
        <div class="detail-content">
          <p><a href="https://github.com/jtvargas/airscanner-web/issues">Report a problem on GitHub.</a> Include your scanner model and what went wrong.</p>
          <p>Posts are public. Do not attach documents, personal details, IP addresses, or scanner serial numbers.</p>
        </div>
      </details>
    </div>
  </section>
</SiteLayout>
